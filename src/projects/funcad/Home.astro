      <section id="benchmark" class="section tint">
        <div class="wrap">
          <header class="section-head" data-reveal>
            <span class="kicker">06 · FunCADBench</span>
            <h2>46 mechanism families.</h2>
            <p class="sub">From clamps and transmissions to clocks, counters, and coin sorters.</p>
          </header>
          <figure class="figure-card zoomable" data-reveal data-full="assets/img/fig3-2000.webp">
            <img src="assets/img/fig3-1200.webp" srcset="assets/img/fig3-1200.webp 1200w, assets/img/fig3-2000.webp 2000w" sizes="(max-width: 1220px) 100vw, 1180px" width="1200" height="753" loading="lazy" decoding="async" alt="Paper Figure 3: 75 mechanisms built by LLM agents across all 46 FunCADBench families" />
            <span class="zoom-hint"><svg><use href="#i-zoom" /></svg></span>
            <figcaption><b>Figure 3.</b> 75 agent-built assemblies covering all 46 families.</figcaption>
          </figure>
