---
import Layout from './Layout.astro';
// Keep an external asset request so this example also exercises asset delivery.
import pathCheck from './assets/path-check.svg?url&no-inline';
---
<Layout
  title="Project path test"
  description="A temporary GenLab page for testing shared project hosting and built assets."
>
  <p class="eyebrow">GenLab · Temporary test</p>
  <h1>Project path test</h1>
  <p class="intro">This temporary page checks project websites published from the shared GenLab website repository. It is not a research project.</p>
  <p class="path">thegenlab.ai/project-test/</p>
  <section class="check" aria-labelledby="asset-heading">
    <img src={pathCheck} alt="A document icon with a check mark" width="64" height="64" />
    <div>
      <h2 id="asset-heading">Project assets</h2>
      <p>The stylesheet and this SVG are built from this project’s website source.</p>
    </div>
  </section>
  <nav aria-label="Test pages">
    <a class="button" href="/project-test/nested/">Open the nested test page <span aria-hidden="true">→</span></a>
    <a href="/">GenLab homepage</a>
  </nav>
  <footer>No research content or personal information is included in this test.</footer>
</Layout>
