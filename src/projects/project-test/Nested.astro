---
import Layout from './Layout.astro';
import pathCheck from './assets/path-check.svg?url&no-inline';
---
<Layout
  title="Nested path test"
  description="A temporary nested page for testing GenLab project paths and shared project assets."
>
  <p class="eyebrow">GenLab · Temporary test</p>
  <h1>Nested path test</h1>
  <p class="intro">This page checks a second directory level within the temporary project website.</p>
  <p class="path">thegenlab.ai/project-test/nested/</p>
  <section class="check" aria-labelledby="asset-heading">
    <img src={pathCheck} alt="A document icon with a check mark" width="64" height="64" />
    <div>
      <h2 id="asset-heading">Shared project assets</h2>
      <p>This page uses the same project layout, stylesheet and SVG as the landing page.</p>
    </div>
  </section>
  <nav aria-label="Test pages">
    <a class="button" href="/project-test/"><span aria-hidden="true">←</span> Back to the project test</a>
    <a href="/">GenLab homepage</a>
  </nav>
  <footer>This is a temporary hosting test, not a research project.</footer>
</Layout>
