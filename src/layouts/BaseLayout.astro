---
import '../styles/global.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — GenLab` : 'GenLab @ CUHK-SZ';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/plex-sans.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta property="og:image:alt" content="GenLab — Understand. Create. An illustrated room showing surfaces, structure, and possible variations." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header class="header">
        <a class="brand" href="/" aria-label="GenLab home">Gen<span>Lab</span></a>
        <nav aria-label="Lab links"><a href="https://github.com/thegenlab" target="_blank" rel="noopener">GitHub ↗</a></nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
