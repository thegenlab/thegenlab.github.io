---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
const publications = (await getCollection('publications', ({ data }) => data.featured)).sort((a,b) => a.data.order - b.data.order);
const people = (await getCollection('people')).sort((a,b) => a.data.order - b.data.order);
const today = new Date();
const news = (await getCollection('news', ({data}) => data.date <= today)).sort((a,b) => +b.data.date - +a.data.date).slice(0,3);
---
<BaseLayout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>A research group at CUHK-Shenzhen</p>
      <h1 id="hero-title">Learning to<br />understand.<br /><em>Learning to create.</em></h1>
      <p class="hero-description">We explore generative AI and machine learning to understand, create, and interact with a three-dimensional world.</p>
      <a class="text-link hero-link" href="#work">Explore our work <Arrow /></a>
    </div>
    <figure class="hero-art">
      <img src="/images/generative-form.svg" width="600" height="510" alt="An abstract folded surface formed from fine green lines and points." fetchpriority="high" />
      <figcaption><span>FROM POSSIBILITY TO FORM</span><span>GENLAB / 01</span></figcaption>
    </figure>
  </section>

  <section class="work-section wrap" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">Ideas, made tangible</p><h2 id="work-title">Selected work<span class="title-period">.</span></h2></div><a class="subtle-link" href="https://itszhen.com/#pub">Full publication list <Arrow diagonal /></a></div>
    <div class="project-grid">
      {publications.map(({ data }, index) => <article class="project-card">
        <a class:list={['project-image', `project-image-${index+1}`]} href={data.links[0].url} aria-label={`Explore ${data.name}`}>
          <img src={data.image} alt={data.imageAlt} width="800" height="480" loading="lazy" style={`object-fit: ${data.imageFit}`} />
          <span class="image-arrow"><Arrow diagonal /></span>
        </a>
        <div class="project-meta"><span>{data.venue}</span><span>{data.year}</span></div>
        <h3><a href={data.links[0].url}>{data.name}</a></h3>
        <p class="project-title">{data.title}</p>
        <p class="project-summary">{data.summary}</p>
        <div class="project-links">{data.links.map(link => <a href={link.url}>{link.label}<Arrow diagonal /></a>)}</div>
      </article>)}
    </div>
  </section>

  {news.length > 0 && <section class="news-section wrap" aria-labelledby="news-title"><div class="section-heading"><h2 id="news-title">Latest from the lab.</h2></div><div class="news-list">{news.map(({data}) => <article><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('en-GB', {month:'short',year:'numeric',timeZone:'UTC'})}</time><div><h3>{data.url ? <a href={data.url}>{data.title}<Arrow diagonal /></a> : data.title}</h3><p>{data.description}</p></div></article>)}</div></section>}

  <section class="about-section wrap" id="about" aria-labelledby="about-title">
    <div class="about-copy"><p class="eyebrow">The lab</p><h2 id="about-title">Curiosity across<br /><em>dimensions.</em></h2><p>GenLab is led by <a href={site.homepage}>Prof. Zhen Liu</a> at the {site.school}, {site.university}. Our research spans generative models, spatial and physical intelligence, and foundation model adaptation.</p><div class="research-tags"><span>Generative AI</span><span>3D & spatial intelligence</span><span>Machine learning</span></div></div>
    <div class="about-details">
      <div class="people-summary"><p class="eyebrow">People</p>{people.map(({ data }) => <div class="person"><span class="person-initials" aria-hidden="true">{data.initials}</span><div><a href={data.links[0]?.url || site.homepage}>{data.name}<Arrow diagonal /></a><p>{data.role}</p></div></div>)}</div>
      <div class="contact-summary"><p class="eyebrow">Let’s connect</p><p>Interested in our research, collaboration, or joining the group? We’d like to hear from you.</p><a class="text-link" href={`mailto:${site.email}`}>{site.email}<Arrow diagonal /></a><a class="subtle-link opportunities-link" href="https://itszhen.com/#contact">Prospective students & opportunities <Arrow diagonal /></a></div>
    </div>
  </section>
</BaseLayout>
