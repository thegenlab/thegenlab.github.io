---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import conceptArt from '../assets/concept-room.png';
const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const collaborators = (await getCollection('collaborators')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications', ({ data }) => data.featured)).sort((a,b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="intro" aria-labelledby="title">
    <div>
      <h1 id="title">Understand.<br />Create.</h1>
      <p>We study generative models, 3D reasoning, and how learning systems interact with the physical world.</p>
    </div>
    <figure class="concept-art">
      <Image src={conceptArt} alt="A room combining visible surfaces, structural drawings, and possible variations." widths={[600, 1000, 1536]} sizes="(max-width: 560px) calc(100vw - 40px), (max-width: 1000px) 55vw, 710px" format="webp" loading="eager" fetchpriority="high" />
    </figure>
  </section>
  {publications.length > 0 && <section class="projects" id="work" aria-labelledby="work-title" data-carousel>
    <div class="section-head">
      <h2 id="work-title">Selected research</h2>
      <div class="research-actions">
        <a href="https://itszhen.com/#pub" target="_blank" rel="noopener">All publications ↗</a>
        <div class="carousel-controls" hidden>
          <button type="button" data-previous aria-label="Previous projects" aria-controls="research-track" aria-disabled="true"><span aria-hidden="true">←</span></button>
          <button type="button" data-next aria-label="Next projects" aria-controls="research-track"><span aria-hidden="true">→</span></button>
        </div>
      </div>
    </div>
    <p class="sr-only" id="research-help">Scroll horizontally to explore projects. With this list focused, use the left and right arrow keys, or Home and End.</p>
    <ul class="research-track" id="research-track" tabindex="0" aria-label="Research projects" aria-describedby="research-help">
      {publications.map(({ id, data }) => <li class="research-slide">
        <article class="project" aria-labelledby={`project-${id}`}>
          <a class="project-image" href={data.links[0].url} target="_blank" rel="noopener" aria-label={`${data.name} project`}>
            <img src={data.image} alt={data.imageAlt} width="600" height="340" loading="lazy" style={`object-fit: ${data.imageFit}`} />
          </a>
          <div class="project-meta"><span>{data.venue}</span><span>{data.year}</span></div>
          <h3 id={`project-${id}`}><a href={data.links[0].url} target="_blank" rel="noopener">{data.name}</a></h3>
          <p class="project-description">{data.summary}</p>
          <nav class="project-links" aria-label={`${data.name} links`}>
            {data.links.map((link, index) => <a href={link.url} target="_blank" rel="noopener">{link.label}{index === 0 && ' ↗'}</a>)}
          </nav>
        </article>
      </li>)}
    </ul>
  </section>}
  <section class="people-section" id="team" aria-labelledby="team-title">
    <h2 id="team-title">Team</h2>
    <ul class="people-list">
      {people.map(({ data }) => <li>
        <h3 class="person-name">{data.links[0] ? <a href={data.links[0].url} target="_blank" rel="noopener">{data.name}</a> : data.name}</h3>
        <p class="person-detail">{data.role}</p>
      </li>)}
    </ul>
  </section>
  <section class="people-section" id="collaborators" aria-labelledby="collaborators-title">
    <h2 id="collaborators-title">External collaborators</h2>
    <ul class="people-list">
      {collaborators.map(({ data }) => <li>
        <h3 class="person-name">{data.links[0] ? <a href={data.links[0].url} target="_blank" rel="noopener">{data.name}</a> : data.name}</h3>
        <p class="person-detail">{data.affiliation}</p>
      </li>)}
    </ul>
  </section>
</BaseLayout>
<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const track = carousel.querySelector<HTMLUListElement>('.research-track')!;
    const controls = carousel.querySelector<HTMLElement>('.carousel-controls')!;
    const previous = controls.querySelector<HTMLButtonElement>('[data-previous]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-next]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const tolerance = 2;
    let requestedPosition: number | null = null;
    const maximum = () => Math.max(0, track.scrollWidth - track.clientWidth);
    const positions = () => {
      const start = track.getBoundingClientRect().left + track.clientLeft;
      return Array.from(track.children, slide => Math.min(maximum(), Math.max(0, slide.getBoundingClientRect().left - start + track.scrollLeft)));
    };
    const update = () => {
      const max = maximum();
      controls.hidden = max <= tolerance;
      previous.setAttribute('aria-disabled', String(track.scrollLeft <= tolerance));
      next.setAttribute('aria-disabled', String(track.scrollLeft >= max - tolerance));
    };
    const go = (position: number) => {
      requestedPosition = Math.max(0, Math.min(maximum(), position));
      track.scrollTo({ left: requestedPosition, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };
    const step = (direction: number) => {
      const current = requestedPosition ?? track.scrollLeft;
      const stops = positions();
      go(direction > 0
        ? stops.find(position => position > current + tolerance) ?? maximum()
        : stops.reverse().find(position => position < current - tolerance) ?? 0);
    };
    previous.addEventListener('click', () => { if (previous.getAttribute('aria-disabled') !== 'true') step(-1); });
    next.addEventListener('click', () => { if (next.getAttribute('aria-disabled') !== 'true') step(1); });
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('scrollend', () => { requestedPosition = null; update(); });
    for (const event of ['pointerdown', 'wheel']) track.addEventListener(event, () => { requestedPosition = null; }, { passive: true });
    track.addEventListener('keydown', event => {
      if (event.target !== track || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault(); step(event.key === 'ArrowRight' ? 1 : -1);
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault(); go(event.key === 'Home' ? 0 : maximum());
      }
    });
    track.addEventListener('focusin', event => {
      if (!(event.target instanceof HTMLElement)) return;
      const slide = event.target.closest<HTMLElement>('.research-slide');
      if (!slide) return;
      const bounds = slide.getBoundingClientRect(), viewport = track.getBoundingClientRect();
      if (bounds.left < viewport.left - tolerance || bounds.right > viewport.right + tolerance) {
        // Reveal the whole card when keyboard focus reaches one of its links.
        requestedPosition = null;
        track.scrollTo({ left: Math.min(maximum(), track.scrollLeft + bounds.left - viewport.left), behavior: 'instant' });
      }
    });
    new ResizeObserver(() => { requestedPosition = null; update(); }).observe(track);
    new MutationObserver(update).observe(track, { childList: true });
    update();
  }
</script>
